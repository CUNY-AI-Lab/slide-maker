{
  "name": "slide-maker",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "vitest run && bash tests/run_all.sh",
    "check": "bun run --cwd apps/web check && bun run test && bun run build",
    "db:push": "pnpm --filter api db:push",
    "db:seed": "pnpm --filter api db:seed",
    "seed:admin": "pnpm --filter api seed:admin",
    "audit:a11y": "node scripts/a11y-theme-audit.mjs",
    "start": "tsx apps/api/src/index.ts",
    "api:dev": "pnpm --filter @slide-maker/api dev",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@tiptap/core": "3.30.5",
      "@tiptap/pm": "3.30.5",
      "@xmldom/xmldom": "0.8.15",
      "brace-expansion": "2.1.6",
      "devalue": "5.9.3",
      "dompurify": "3.4.17",
      "drizzle-orm": "0.45.4",
      "fast-xml-builder": "1.1.7",
      "hono": "4.12.25",
      "linkify-it": "5.0.2",
      "lodash": "4.18.1",
      "markdown-it": "14.3.3",
      "nanoid": "3.3.20",
      "nodemailer": "10.0.6",
      "postcss": "8.5.18",
      "prosemirror-view": "1.42.3",
      "shell-quote": "1.11.0",
      "source-map-js": "1.2.2",
      "tinypool": "2.1.2",
      "vitest": "3.2.6",
      "zod": "4.6.6"
    }
  }
}
