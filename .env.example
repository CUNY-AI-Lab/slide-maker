# API Server
# Keep the default loopback listener. Set API_HOST=0.0.0.0 only for explicit local device testing.
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_URL=file:./data/slide-maker.db

# Auth
SESSION_SECRET=change-me-to-random-string

# Email — pick one provider: ses or smtp
# Set EMAIL_PROVIDER=ses to use Amazon SES (uses AWS credentials for email only)
EMAIL_PROVIDER=ses
SES_FROM_EMAIL=ailab@gc.cuny.edu
# SES_REGION=us-east-1  # defaults to AWS_REGION if not set

# Or use SMTP (leave EMAIL_PROVIDER blank or unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ailab.gc.cuny.edu

# Institutional identity: public JWKS JSON snapshot and exact issuer URL
CAIL_IDENTITY_JWKS=
CAIL_IDENTITY_ISSUER=https://tools.ailab.gc.cuny.edu/cail-sso
# Gateway base URL is the origin, distinct from the identity issuer /cail-sso path.
# It must be a reviewed reachable receiver; never provider credentials.
CAIL_GATEWAY_URL=https://tools.ailab.gc.cuny.edu
# Private readiness probe; random operator-held token and exact deployed commit.
READINESS_TOKEN=
RELEASE_SHA=

# Web Search
TAVILY_API_KEY=
BRAVE_API_KEY=

# Image Search (Pexels — openly licensed images)
PEXELS_API_KEY=

# Frontend
PUBLIC_API_URL=http://localhost:3001
PUBLIC_URL=http://localhost:5173
# Production: PUBLIC_URL=https://tools.ailab.gc.cuny.edu/slide-maker
